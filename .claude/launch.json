{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desk-api",
      "runtimeExecutable": "backend/.venv/bin/desk",
      "runtimeArgs": [
        "serve",
        "--port",
        "8767"
      ],
      "port": 8767
    },
    {
      "name": "validation-reports",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        ".devdata/reports"
      ],
      "port": 8766
    }
  ]
}
