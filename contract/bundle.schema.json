   "description": "1.3: справочник ставок фондирования на прогон (§0.5)",
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ccy"
    ],
    "properties": {
     "book_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "desk": {
      "type": [
       "string",
       "null"
      ]
     },
     "book_id": {
