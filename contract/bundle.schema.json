{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "trading-desk-monitor/bundle-1.3",
 "title": "Trading Desk Monitor — пакет расчётного прогона (contract 1.3)",
 "description": "Один прогон = один файл. Описание полей и методик: docs/DATA_CONTRACT.md. Суммы в RUB, если не указано иное.",
 "type": "object",
 "required": [
  "contract_version",
  "run",
  "books",
  "curves",
  "fx",
  "positions"
 ],
 "properties": {
  "contract_version": {
   "enum": [
    "1.0",
    "1.1",
    "1.2",
    "1.3"
   ]
  },
  "run": {
   "type": "object",
   "required": [
    "as_of"
   ],
   "properties": {
    "as_of": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "run_type": {
     "enum": [
      "EOD",
      "INTRADAY",
      "TEST"
     ]
    },
    "source": {
     "type": [
      "string",
      "null"
     ]
    },
    "lib_version": {
     "type": [
      "string",
      "null"
     ]
    },
    "market_snapshot": {
     "type": [
      "string",
      "null"
     ]
    },
    "comment": {
     "type": [
      "string",
      "null"
     ]
    },
    "prev_date": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "description": "1.3: прошлый рабочий день; начисления за (prev_date, as_of]. По умолчанию — из календаря"
    },
    "accrual_days": {
     "type": [
      "integer",
      "null"
     ],
     "description": "1.3: календарных дней начисления (в понедельник — 3)"
    },
    "jtd_recovery": {
     "type": [
      "number",
      "null"
     ],
     "description": "1.3: recovery для JTD облигаций, доля (по умолчанию 0)"
    },
    "ofz_spread_move": {
     "type": [
      "number",
      "null"
     ],
     "description": "1.3: изменение спреда ОФЗ к RUONIA за день, б.п. (справочно)"
    },
    "derive_funding": {
     "type": "boolean",
     "description": "1.3: недостающие строки фондирования (POS, HTM, CASH, REPO) строит tdm из позиций, справочника ставок, cash_balances и funding"
    }
   }
  },
  "buckets": {
   "description": "Справочно; бакеты фиксированы в ref_bucket",
   "type": "array"
  },
  "ratings": {
   "description": "Справочно; порядок рейтингов — ref_rating",
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "books": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "book_id",
     "name",
     "desk"
    ],
    "properties": {
     "book_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "desk": {
      "type": "string"
     },
     "trader": {
      "type": [
       "string",
       "null"
      ]
     },
     "book_type": {
      "enum": [
       "TRADING",
       "HTM",
       "DERIVS",
       null
      ],
      "description": "1.3: режим фондирования книги (обязательно)"
     },
     "entity": {
      "type": [
       "string",
       "null"
      ],
      "description": "1.3: юрлицо (обязательно)"
     },
     "ocp_to": {
      "type": [
       "string",
       "null"
      ],
      "description": "1.3: книга деривативов, куда вечером передаётся ОВП"
     }
    }
   }
  },
  "issuers": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "issuer",
     "issuer_group"
    ],
    "properties": {
     "issuer": {
      "type": "string"
     },
     "issuer_group": {
      "type": "string"
     },
     "sector": {
      "type": [
       "string",
       "null"
      ]
     },
     "rating": {
      "type": [
       "string",
       "null"
      ]
     },
     "is_gov": {
      "type": "boolean"
     },
     "is_quasi": {
      "type": "boolean"
     }
    }
   }
  },
  "curves": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "curve_id",
     "name",
     "ccy",
     "kind",
     "points"
    ],
    "properties": {
     "curve_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "ccy": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "bond",
       "swap"
      ]
     },
     "points": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
       "type": "object",
       "required": [
        "bucket",
        "rate"
       ],
       "properties": {
        "bucket": {
         "enum": [
          "1M",
          "3M",
          "6M",
          "1Y",
          "2Y",
          "3Y",
          "5Y",
          "7Y",
          "10Y",
          "15Y",
          "20Y+"
         ]
        },
        "rate": {
         "type": "number"
        },
        "move_bp": {
         "type": "number"
        }
       }
      }
     }
    }
   }
  },
  "fx": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ccy",
     "rate"
    ],
    "properties": {
     "ccy": {
      "type": "string"
     },
     "rate": {
      "type": "number",
      "description": "рыночный курс на срез (~19:00), RUB за 1 ед."
     },
     "move_pct": {
      "type": "number"
     },
     "rate_cbr": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: курс ЦБ, действующий на as_of"
     },
     "move_pct_cbr": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: изменение курса ЦБ к прошлому рабочему дню, %"
     },
     "rate_cbr_next": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: курс ЦБ, установленный в as_of на завтра (передача ОВП)"
     }
    }
   }
  },
  "indices": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "index_name",
     "value"
    ],
    "properties": {
     "index_name": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    }
   }
  },
  "scenarios": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "scenario_id",
     "name",
     "definition"
    ],
    "properties": {
     "scenario_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "active": {
      "type": "boolean"
     },
     "definition": {
      "type": "object",
      "properties": {
       "curves": {
        "type": "object",
        "additionalProperties": {
         "oneOf": [
          {
           "type": "number"
          },
          {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 11,
           "maxItems": 11
          }
         ]
        }
       },
       "fx": {
        "type": "object",
        "additionalProperties": {
         "type": "number"
        }
       },
       "spreads": {
        "type": "object",
        "description": "{_all, _mult, rating: {AA: 50}, sector: {...}, issuer: {...}}, правила аддитивны"
       },
       "ofzSpread": {
        "type": "number",
        "description": "1.3: сдвиг спреда ОФЗ к RUONIA, б.п."
       }
      }
     }
    }
   }
  },
  "positions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "position_id",
     "book_id",
     "instr_type",
     "asset_class",
     "segment",
     "name",
     "ccy",
     "notional",
     "mv",
     "mv_rub",
     "dv01"
    ],
    "properties": {
     "position_id": {
      "type": "string"
     },
     "book_id": {
      "type": "string"
     },
     "instr_type": {
      "enum": [
       "BOND",
       "IRS",
       "XCCY",
       "CDS",
       "FX"
      ]
     },
     "asset_class": {
      "type": "string"
     },
     "segment": {
      "enum": [
       "Гос",
       "Корп",
       "Секьюритизация",
       "Деривативы",
       "FX"
      ]
     },
     "name": {
      "type": "string"
     },
     "isin": {
      "type": [
       "string",
       "null"
      ]
     },
     "issuer": {
      "type": [
       "string",
       "null"
      ]
     },
     "ccy": {
      "type": "string"
     },
     "maturity": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "tenor_y": {
      "type": [
       "number",
       "null"
      ]
     },
     "coupon_type": {
      "enum": [
       "fix",
       "float",
       null
      ]
     },
     "coupon": {
      "type": [
       "number",
       "null"
      ]
     },
     "index_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "margin": {
      "type": [
       "number",
       "null"
      ]
     },
     "side": {
      "type": [
       "string",
       "null"
      ]
     },
     "notional": {
      "type": "number"
     },
     "notional_rub": {
      "type": [
       "number",
       "null"
      ]
     },
     "price": {
      "type": [
       "number",
       "null"
      ]
     },
     "mv": {
      "type": "number"
     },
     "mv_rub": {
      "type": "number"
     },
     "ytm": {
      "type": [
       "number",
       "null"
      ]
     },
     "spread_bp": {
      "type": [
       "number",
       "null"
      ]
     },
     "mdur": {
      "type": [
       "number",
       "null"
      ]
     },
     "spr_dur": {
      "type": [
       "number",
       "null"
      ]
     },
     "convexity": {
      "type": [
       "number",
       "null"
      ],
      "description": "выпуклость к доходности, лет²; второй порядок для сценариев, если нет gamma"
     },
     "dv01": {
      "type": "number"
     },
     "cs01": {
      "type": [
       "number",
       "null"
      ]
     },
     "jtd": {
      "type": [
       "number",
       "null"
      ]
     },
     "wal": {
      "type": [
       "number",
       "null"
      ]
     },
     "cpr": {
      "type": [
       "number",
       "null"
      ]
     },
     "counterparty": {
      "type": [
       "string",
       "null"
      ]
     },
     "new_today": {
      "type": "boolean"
     },
     "instrument_id": {
      "type": [
       "string",
       "null"
      ],
      "description": "BOND: ключ ref_instrument / md_bond_quote (NULL — ищется по isin, затем isin как ключ). Нужен для изменений за день и истории выпуска"
     },
     "accrued": {
      "type": [
       "number",
       "null"
      ],
      "description": "BOND: НКД, % номинала"
     },
     "coupon_freq": {
      "type": [
       "integer",
       "null"
      ],
      "description": "BOND: купонов в год"
     },
     "yield_date": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "BOND: дата, к которой посчитаны ytm и spread_bp (оферта/колл); NULL — погашение"
     },
     "spread_type": {
      "enum": [
       "Z",
       "G",
       "I",
       "DM",
       "OAS",
       "ASW",
       null
      ],
      "description": "BOND: что лежит в spread_bp"
     },
     "spread_curve": {
      "type": [
       "string",
       "null"
      ],
      "description": "BOND: кривая, к которой посчитан spread_bp (для DM — кривая индекса)"
     },
     "extra": {
      "type": "object"
     },
     "risk": {
      "type": "object",
      "description": "{curve_id: {bucket: dv01}}. С desk 0.2.7 (extra.ofz_ruonia01 у строки, source.ofzScheme = ruonia_basis у desk-data.js) у ОФЗ-ПД/АД/ИН на КБД: RUB OFZ — риск базиса (par-доходности КБД при неизменной RUONIA, равен par-риску КБД), RUB RUONIA — риск RUONIA (котировки OIS при неизменном базисе) минус риск базиса; сумма по кривым — риск RUONIA (extra.ofz_ruonia01), сценарий по RUB OFZ и RUB RUONIA считается по ним точно",
      "additionalProperties": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "1M",
         "3M",
         "6M",
         "1Y",
         "2Y",
         "3Y",
         "5Y",
         "7Y",
         "10Y",
         "15Y",
         "20Y+"
        ]
       },
       "additionalProperties": {
        "type": "number"
       }
      }
     },
     "fx_delta": {
      "type": "object",
      "description": "{ccy: amount}",
      "additionalProperties": {
       "type": "number"
      }
     },
     "pnl": {
      "type": "object",
      "properties": {
       "carry": {
        "type": "number"
       },
       "rolldown": {
        "type": "number"
       },
       "rates": {
        "type": "number"
       },
       "spread": {
        "type": "number"
       },
       "fx_gross": {
        "type": "number"
       },
       "fx_funding": {
        "type": "number",
        "description": "FX-переоценка тела фондирования самой бумаги (= fx_allocated её строки POS)"
       },
       "convexity": {
        "type": "number"
       },
       "new_trades": {
        "type": "number"
       },
       "other": {
        "type": "number"
       },
       "official": {
        "type": [
         "number",
         "null"
        ]
       },
       "break_note": {
        "type": [
         "string",
         "null"
        ]
       },
       "funding": {
        "type": [
         "number",
         "null"
        ],
        "description": "1.3: процент по фондированию бумаги за день (строка POS / HTM)"
       },
       "fx_gross_cbr": {
        "type": [
         "number",
         "null"
        ],
        "description": "1.3: fx_gross по курсам ЦБ"
       },
       "fx_funding_cbr": {
        "type": [
         "number",
         "null"
        ],
        "description": "1.3: fx_funding по курсам ЦБ"
       }
      }
     },
     "gamma": {
      "type": "array",
      "description": "Вторые производные PV_RUB: [[factor_1, factor_2, d2PV]]; факторы 'IR|<curve>|<bucket>' (1 б.п.), 'CS' (свой спред, 1 б.п.), 'FX|<ccy>' (1 %). Пара один раз; вклад ½Γ·Δa² (диагональ), Γ·Δa·Δb (вне диагонали). См. DATA_CONTRACT §4.3.3",
      "items": {
       "type": "array",
       "prefixItems": [
        {
         "type": "string",
         "pattern": "^(IR\\|[^|]+\\|[^|]+|CS|FX\\|[A-Z]{3})$"
        },
        {
         "type": "string",
         "pattern": "^(IR\\|[^|]+\\|[^|]+|CS|FX\\|[A-Z]{3})$"
        },
        {
         "type": "number"
        }
       ],
       "minItems": 3,
       "maxItems": 3
      }
     },
     "ofz_spr01": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: ОФЗ — RUB за +1 б.п. спреда ОФЗ к кривой её дисконтирования; прочие 0. До desk 0.2.6 — спред к RUONIA (базис ОФЗ); с 0.2.6 (source.ofzScheme = kbd_par у desk-data.js) у ОФЗ-ПД/АД/ИН — спред к КБД, их базис к RUONIA — extra.ofz_basis01; у ОФЗ-ПК — по-прежнему спред к RUONIA"
     },
     "accrual_only": {
      "type": [
       "boolean",
       "null"
      ],
      "description": "1.3: HTM — учёт по начислению, вне рыночных рисков"
     },
     "purchase_date": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "1.3: HTM — дата покупки"
     },
     "purchase_price": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: HTM — чистая цена покупки, % номинала"
     },
     "purchase_yield": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: HTM — доходность покупки, %"
     },
     "contract_rate": {
      "type": [
       "number",
       "null"
      ],
      "description": "1.3: HTM — контрактная ставка фондирования, %"
     },
     "ocp_transfer": {
      "type": [
       "boolean",
       "null"
      ],
      "description": "1.3: сделка вечерней передачи ОВП (или extra.ocp_transfer)"
     }
    }
   }
  },
