{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "trading-desk-monitor/bundle-1.0",
 "title": "Trading Desk Monitor — пакет расчётного прогона (contract 1.0)",
 "description": "Один прогон = один файл. Описание полей и методик: docs/DATA_CONTRACT.md. Суммы в RUB, если не указано иное.",
 "type": "object",
 "required": [
  "contract_version",
  "run",
  "books",
  "curves",
  "fx",
  "positions"
 ],
 "properties": {
  "contract_version": {
   "const": "1.0"
  },
  "run": {
   "type": "object",
   "required": [
    "as_of"
   ],
   "properties": {
    "as_of": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "run_type": {
     "enum": [
      "EOD",
      "INTRADAY",
      "TEST"
     ]
    },
    "source": {
     "type": [
      "string",
      "null"
     ]
    },
    "lib_version": {
     "type": [
      "string",
      "null"
     ]
    },
    "market_snapshot": {
     "type": [
      "string",
      "null"
     ]
    },
    "comment": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "buckets": {
   "description": "Справочно; бакеты фиксированы в ref_bucket",
   "type": "array"
  },
  "ratings": {
   "description": "Справочно; порядок рейтингов — ref_rating",
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "books": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "book_id",
     "name",
     "desk"
    ],
    "properties": {
     "book_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "desk": {
      "type": "string"
     },
     "trader": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   }
  },
  "issuers": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "issuer",
     "issuer_group"
    ],
    "properties": {
     "issuer": {
      "type": "string"
     },
     "issuer_group": {
      "type": "string"
     },
     "sector": {
      "type": [
       "string",
       "null"
      ]
     },
     "rating": {
      "type": [
       "string",
       "null"
      ]
     },
     "is_gov": {
      "type": "boolean"
     },
     "is_quasi": {
      "type": "boolean"
     }
    }
   }
  },
  "curves": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "curve_id",
     "name",
     "ccy",
     "kind",
     "points"
    ],
    "properties": {
     "curve_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "ccy": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "bond",
       "swap"
      ]
     },
     "points": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
       "type": "object",
       "required": [
        "bucket",
        "rate"
       ],
       "properties": {
        "bucket": {
         "enum": [
          "1M",
          "3M",
          "6M",
          "1Y",
          "2Y",
          "3Y",
          "5Y",
          "7Y",
          "10Y",
          "15Y",
          "20Y+"
         ]
        },
        "rate": {
         "type": "number"
        },
        "move_bp": {
         "type": "number"
        }
       }
      }
     }
    }
   }
  },
  "fx": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ccy",
     "rate"
    ],
    "properties": {
     "ccy": {
      "type": "string"
     },
     "rate": {
      "type": "number"
     },
     "move_pct": {
      "type": "number"
     }
    }
   }
  },
  "indices": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "index_name",
     "value"
    ],
    "properties": {
     "index_name": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    }
   }
  },
  "scenarios": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "scenario_id",
     "name",
     "definition"
    ],
    "properties": {
     "scenario_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "active": {
      "type": "boolean"
     },
     "definition": {
      "type": "object",
      "properties": {
       "curves": {
        "type": "object",
        "additionalProperties": {
         "oneOf": [
          {
           "type": "number"
          },
          {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 11,
           "maxItems": 11
          }
         ]
        }
       },
       "fx": {
        "type": "object",
        "additionalProperties": {
         "type": "number"
        }
       },
       "spreads": {
        "type": "object"
       }
      }
     }
    }
   }
  },
  "positions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "position_id",
     "book_id",
     "instr_type",
     "asset_class",
     "segment",
     "name",
     "ccy",
     "notional",
     "mv",
     "mv_rub",
     "dv01"
    ],
    "properties": {
     "position_id": {
      "type": "string"
     },
     "book_id": {
      "type": "string"
     },
     "instr_type": {
      "enum": [
       "BOND",
       "IRS",
       "XCCY",
       "CDS",
       "FX"
      ]
     },
     "asset_class": {
      "type": "string"
     },
     "segment": {
      "enum": [
       "Гос",
       "Корп",
       "Секьюритизация",
       "Деривативы",
       "FX"
      ]
     },
     "name": {
      "type": "string"
     },
     "isin": {
      "type": [
       "string",
       "null"
      ]
     },
     "issuer": {
      "type": [
       "string",
       "null"
      ]
     },
     "ccy": {
      "type": "string"
     },
     "maturity": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "tenor_y": {
      "type": [
       "number",
       "null"
      ]
     },
     "coupon_type": {
      "enum": [
       "fix",
       "float",
       null
      ]
     },
     "coupon": {
      "type": [
       "number",
       "null"
      ]
     },
     "index_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "margin": {
      "type": [
       "number",
       "null"
      ]
     },
     "side": {
      "type": [
       "string",
       "null"
      ]
     },
     "notional": {
      "type": "number"
     },
     "notional_rub": {
      "type": [
       "number",
       "null"
      ]
     },
     "price": {
      "type": [
       "number",
       "null"
      ]
     },
     "mv": {
      "type": "number"
     },
     "mv_rub": {
      "type": "number"
     },
     "ytm": {
      "type": [
       "number",
       "null"
      ]
     },
     "spread_bp": {
      "type": [
       "number",
       "null"
      ]
     },
     "mdur": {
      "type": [
       "number",
       "null"
      ]
     },
     "spr_dur": {
      "type": [
       "number",
       "null"
      ]
     },
     "convexity": {
      "type": [
       "number",
       "null"
      ]
     },
     "dv01": {
      "type": "number"
     },
     "cs01": {
      "type": [
       "number",
       "null"
      ]
     },
     "jtd": {
      "type": [
       "number",
       "null"
      ]
     },
     "wal": {
      "type": [
       "number",
       "null"
      ]
     },
     "cpr": {
      "type": [
       "number",
       "null"
      ]
     },
     "counterparty": {
      "type": [
       "string",
       "null"
      ]
     },
     "new_today": {
      "type": "boolean"
     },
     "extra": {
      "type": "object"
     },
     "risk": {
      "type": "object",
      "description": "{curve_id: {bucket: dv01}}",
      "additionalProperties": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "1M",
         "3M",
         "6M",
         "1Y",
         "2Y",
         "3Y",
         "5Y",
         "7Y",
         "10Y",
         "15Y",
         "20Y+"
        ]
       },
       "additionalProperties": {
        "type": "number"
       }
      }
     },
     "fx_delta": {
      "type": "object",
      "description": "{ccy: amount}",
      "additionalProperties": {
       "type": "number"
      }
     },
     "pnl": {
      "type": "object",
      "properties": {
       "carry": {
        "type": "number"
       },
       "rolldown": {
        "type": "number"
       },
       "rates": {
        "type": "number"
       },
       "spread": {
        "type": "number"
       },
       "fx_gross": {
        "type": "number"
       },
       "fx_funding": {
        "type": "number"
       },
       "convexity": {
        "type": "number"
       },
       "new_trades": {
        "type": "number"
       },
       "other": {
        "type": "number"
       },
       "official": {
        "type": [
         "number",
         "null"
        ]
       },
       "break_note": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "funding": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "deal_id",
     "book_id",
     "type",
     "ccy",
     "amount",
     "rate",
     "maturity"
    ],
    "properties": {
     "deal_id": {
      "type": "string"
     },
     "book_id": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "ccy": {
      "type": "string"
     },
     "amount": {
      "type": "number"
     },
     "rate_expr": {
      "type": [
       "string",
       "null"
      ]
     },
     "rate": {
      "type": "number"
     },
     "start_date": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "maturity": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "counterparty": {
      "type": [
       "string",
       "null"
      ]
     },
     "collateral": {
      "type": [
       "string",
       "null"
      ]
     },
     "pnl": {
      "type": "object",
      "properties": {
       "carry": {
        "type": "number"
       },
       "fx_gross": {
        "type": "number"
       },
       "fx_allocated": {
        "type": "number"
       }
      }
     }
    }
   }
  },
  "scenario_results": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "scenario_id",
     "positions"
    ],
    "properties": {
     "scenario_id": {
      "type": "string"
     },
     "positions": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "position_id",
        "total"
       ],
       "properties": {
        "rates": {
         "type": "number"
        },
        "spread": {
         "type": "number"
        },
        "fx_gross": {
         "type": "number"
        },
        "fx_funding": {
         "type": "number"
        },
        "convexity": {
         "type": "number"
        },
        "total": {
         "type": "number"
        },
        "position_id": {
         "type": "string"
        }
       }
      }
     },
     "funding_residual": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     }
    }
   }
  },
  "history": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "as_of",
     "pnl_official",
     "pnl_explained",
     "dv01",
     "cs01"
    ],
    "properties": {
     "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "pnl_official": {
      "type": "number"
     },
     "pnl_explained": {
      "type": "number"
     },
     "dv01": {
      "type": "number"
     },
     "cs01": {
      "type": "number"
     }
    }
   }
  }
 }
}
