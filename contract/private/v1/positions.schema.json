{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private/1.1/positions",
  "title": "positions row",
  "description": "Private input contract v1 (docs/architecture/08_PRIVATE_ADAPTER_INTERFACE.md §10). One row as the adapter emits it. An optional field may be absent or null (the same thing); the empty string is invalid everywhere. Raw firm values go in x_* keys; _src is the row's location in the report, without sheet names.",
  "type": "object",
  "required": [
    "_src",
    "book_id",
    "position_id",
    "asset_class",
    "source_instrument_id",
    "ccy"
  ],
  "properties": {
    "_src": {
      "$ref": "#/$defs/str"
    },
    "_dataset": {
      "enum": [
        "positions"
      ]
    },
    "book_id": {
      "$ref": "#/$defs/str"
    },
    "position_id": {
      "$ref": "#/$defs/str"
    },
    "asset_class": {
      "enum": [
        "bond",
        "fx",
        "otc",
        "other"
      ]
    },
    "source_instrument_id": {
      "$ref": "#/$defs/str"
    },
    "source_instrument_name": {
      "$ref": "#/$defs/str"
    },
    "isin": {
      "$ref": "#/$defs/str"
    },
    "regnum": {
      "$ref": "#/$defs/str"
    },
    "moex_secid": {
      "$ref": "#/$defs/str"
    },
    "instrument_id": {
      "$ref": "#/$defs/str"
    },
    "ccy": {
      "$ref": "#/$defs/str"
    },
    "quantity": {
      "$ref": "#/$defs/amount"
    },
    "face_amount_ccy": {
      "$ref": "#/$defs/amount"
    },
    "face_outstanding_ccy": {
      "$ref": "#/$defs/amount"
    },
    "amount_ccy": {
      "$ref": "#/$defs/amount"
    },
    "value_date": {
      "$ref": "#/$defs/date"
    },
    "deal_id": {
      "$ref": "#/$defs/str"
    },
    "mark_price_pct": {
      "$ref": "#/$defs/amount"
    },
    "accrued_ccy": {
      "$ref": "#/$defs/amount"
    },
    "mv_rub": {
      "$ref": "#/$defs/amount"
    },
    "book_value_rub": {
      "$ref": "#/$defs/amount"
    },
    "purchase_date": {
      "$ref": "#/$defs/date"
    },
    "purchase_price_pct": {
      "$ref": "#/$defs/amount"
    },
    "purchase_yield_pct": {
      "$ref": "#/$defs/amount"
    },
    "contract_rate_pct": {
      "$ref": "#/$defs/amount"
    },
    "maturity_date": {
      "$ref": "#/$defs/date"
    },
    "risk_dv01_rub": {
      "$ref": "#/$defs/amount"
    },
    "risk_cs01_rub": {
      "$ref": "#/$defs/amount"
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "$defs": {
    "str": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "a finite JSON number or a decimal string; no NaN, exponents in strings, separators or commas"
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  }
}
