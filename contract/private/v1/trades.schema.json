{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private/1.6/trades",
  "title": "trades row",
  "description": "Private input contract v1 (docs/architecture/08_PRIVATE_ADAPTER_INTERFACE.md §10; since 1.6). One trade version as the adapter emits it; the current row of a trade_id is the one with the highest trade_version. Quantities and amounts are unsigned: side gives the direction. An optional field may be absent or null (the same thing); the empty string is invalid everywhere. Raw firm values go in x_* keys; _src is the row's location in the report, without sheet names.",
  "type": "object",
  "required": [
    "_src",
    "trade_id",
    "status",
    "trade_date",
    "book_id",
    "position_id",
    "asset_class",
    "source_instrument_id",
    "side"
  ],
  "properties": {
    "_src": {
      "$ref": "#/$defs/str"
    },
    "_dataset": {
      "enum": [
        "trades"
      ]
    },
    "trade_id": {
      "$ref": "#/$defs/str"
    },
    "trade_version": {
      "$ref": "#/$defs/int"
    },
    "status": {
      "enum": [
        "live",
        "cancelled"
      ]
    },
    "trade_date": {
      "$ref": "#/$defs/date"
    },
    "trade_ts": {
      "$ref": "#/$defs/ts"
    },
    "book_id": {
      "$ref": "#/$defs/str"
    },
    "position_id": {
      "$ref": "#/$defs/str"
    },
    "asset_class": {
      "enum": [
        "bond",
        "fx",
        "otc",
        "other"
      ]
    },
    "source_instrument_id": {
      "$ref": "#/$defs/str"
    },
    "source_instrument_name": {
      "$ref": "#/$defs/str"
    },
    "isin": {
      "$ref": "#/$defs/str"
    },
    "regnum": {
      "$ref": "#/$defs/str"
    },
    "moex_secid": {
      "$ref": "#/$defs/str"
    },
    "instrument_id": {
      "$ref": "#/$defs/str"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ]
    },
    "quantity": {
      "$ref": "#/$defs/amount"
    },
    "face_amount_ccy": {
      "$ref": "#/$defs/amount"
    },
    "amount_ccy": {
      "$ref": "#/$defs/amount"
    },
    "price_pct": {
      "$ref": "#/$defs/amount"
    },
    "fx_rate": {
      "$ref": "#/$defs/amount"
    },
    "accrued_ccy": {
      "$ref": "#/$defs/amount"
    },
    "settle_date": {
      "$ref": "#/$defs/date"
    },
    "counterparty_id": {
      "$ref": "#/$defs/str"
    },
    "ccy": {
      "$ref": "#/$defs/ccy"
    }
  },
  "patternProperties": {
    "^x_": {}
  },
  "additionalProperties": false,
  "$defs": {
    "str": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": [
        "number",
        "string"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "a finite JSON number or a decimal string; no NaN, exponents in strings, separators or commas"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "an ISO 8601 timestamp YYYY-MM-DDTHH:MM[:SS[.ffffff]][Z|+HH:MM]; one without an offset is Moscow time (08 §6.5)"
    },
    "ccy": {
      "type": "string",
      "minLength": 1,
      "description": "a currency code; the backend upper-cases it and reads RUR as RUB"
    },
    "int": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^-?[0-9]+$",
      "description": "an integer: a JSON integer or a string of digits; normalised to an integer"
    }
  }
}
