# Desk backend settings (desk.settings). Copy to backend/.env and fill in; backend/.env is
# git-ignored. Never commit a token.
# Precedence: environment variables > <home>/settings.json (the settings page,
# http://127.0.0.1:8000/settings.html) > this file > defaults. Most installations need
# nothing here: the settings page writes settings.json and the token file in <home>.

# Per-user data folder <home> (settings.json, hub_token, adapter-config/, snapshots/, pg/, ...).
# Default: %LOCALAPPDATA%\DeskMonitor on Windows, <repo>/.devdata in a git checkout,
# else ~/.local/share/desk-monitor.
# DESK_HOME=

# Hub (one instance on the VPS, ADR-001). HTTPS only. Set per installation; the address is
# never kept in the repository.
DESK_HUB_URL=https://<hub host>
# Named token of this consumer, scope "snapshots" (created in the hub admin console).
# Prefer a file outside the repository over the value itself; without either, the token
# saved by the settings page (<home>/hub_token) is used.
DESK_HUB_TOKEN_FILE=~/.config/desk/hub_token
# DESK_HUB_TOKEN=
# DESK_HUB_CA_BUNDLE=          # PEM of the corporate TLS-inspection CA (inside only)
# DESK_HUB_TIMEOUT_S=60
# HTTPS_PROXY=                 # standard proxy variable (environment only; or https_proxy in settings.json)
# DESK_HUB_TRANSPORT=auto      # auto | python | curl (system curl; on Windows logs in to the proxy as the Windows user)
# DESK_PROXY_USER=             # proxy login (DOMAIN\user); empty: curl uses the Windows logon
# DESK_PROXY_PASSWORD=         # or <home>/proxy_password (written by the settings page)

# Local files (relative paths are relative to the repository root). Defaults live in <home>.
# DESK_SNAPSHOT_CACHE=.devdata/snapshots
# DESK_SNAPSHOT_DROP=          # folder filled by hand when the hub is unreachable
# DESK_DB=.devdata/tdm.sqlite
# DESK_REPORT_DIR=.devdata/reports

# Private adapter and report folders (also on the settings page).
# DESK_PRIVATE_ADAPTER=        # package folder of the adapter; unset: reference CSV adapter
# DESK_PRIVATE_ADAPTER_CONFIG= # default <home>/adapter-config
# DESK_INBOX_DIRS=             # folders separated by ";", a trailing \** scans subfolders

# Autopilot of desk serve: hub sync, inbox scan and EOD every DESK_INBOX_POLL_SECONDS.
# DESK_AUTOPILOT=1
# DESK_AUTOPILOT_SYNC_LAST=5
# DESK_INTRADAY=1              # today's book on the hub's intraday cuts (every 30 min), from 19:45 on eod_preliminary
# DESK_HISTORY_DAYS=260        # hub dates of quote history for the bond charts, a few per cycle; 0: off

# Windows bundle: the folder holding update zips the settings page offers to install (a network share, say).
# DESK_UPDATE_DIR=
