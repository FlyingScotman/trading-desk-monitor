[
 {
  "id": "entities",
  "title": "Юрлица",
  "file": "entities.json",
  "help": "Юрлица, их схема фондирования и списание PnL (ORG_RULES §1, §3).",
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "title": "Юрлица",
   "required": [
    "entities"
   ],
   "properties": {
    "entities": {
     "type": "array",
     "title": "Юрлица",
     "items": {
      "type": "object",
      "properties": {
       "entity": {
        "type": "string",
        "minLength": 1,
        "title": "Код юрлица",
        "description": "Точно как entity в books.json и в отчётах"
       },
       "name": {
        "type": "string",
        "minLength": 1,
        "title": "Название"
       },
       "funding_scheme": {
        "type": "string",
        "enum": [
         "by_book_type",
         "cash_balance"
        ],
        "title": "Схема фондирования",
        "description": "by_book_type — по правилам типа каждой книги; cash_balance — весь кэш-баланс"
       },
       "pnl_sweep": {
        "type": "string",
        "enum": [
         "daily",
         "monthly",
         "quarterly",
         "none"
        ],
        "title": "Списание PnL",
        "description": "Как часто PnL уходит из кэша"
       },
       "active": {
        "type": "boolean",
        "title": "Действует",
        "default": true
       },
       "valid_from": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "title": "Действует с",
        "description": "Первый рабочий день строки (история — несколько строк)"
       }
      },
      "required": [
       "entity",
       "funding_scheme"
      ],
      "patternProperties": {
       "^x_": {}
      },
      "additionalProperties": false
     }
    }
   },
   "patternProperties": {
    "^_": {}
   },
   "additionalProperties": false
  }
 },
 {
  "id": "books",
  "title": "Книги",
  "file": "books.json",
  "help": "Тип книги, юрлицо, перенос ОВП (ORG_RULES §2, §4).",
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "title": "Книги",
   "required": [
    "books"
   ],
   "properties": {
    "books": {
     "type": "array",
     "title": "Книги",
     "items": {
      "type": "object",
      "properties": {
       "book_id": {
        "type": "string",
        "minLength": 1,
        "title": "Код книги",
        "description": "Уникальный, во всех юрлицах"
       },
       "name": {
        "type": "string",
        "minLength": 1,
        "title": "Название"
       },
       "desk": {
        "type": "string",
        "minLength": 1,
        "title": "Деск"
       },
       "book_type": {
        "type": "string",
        "enum": [
         "TRADING",
         "HTM",
         "DERIVS",
         "FUTURES"
        ],
        "title": "Тип книги",
        "description": "TRADING — бондовая, HTM, DERIVS — деривативная, FUTURES — фьючерсная"
       },
       "entity": {
        "type": "string",
        "minLength": 1,
        "title": "Юрлицо",
        "description": "Код из entities.json, точно как в колонке Entity"
       },
       "ocp_to": {
        "type": "string",
        "minLength": 1,
        "title": "ОВП переносится в",
        "description": "book_id книги, принимающей ОВП"
       },
       "trader": {
        "type": "string",
        "minLength": 1,
        "title": "Трейдер"
       },
       "active": {
        "type": "boolean",
        "title": "Действует",
        "default": true
       },
       "valid_from": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "title": "Действует с"
       },
       "codes": {
        "type": "object",
        "title": "Коды книги в отчётах",
        "description": "Источник (или * — любой) → коды колонки Book",
        "propertyNames": {
         "enum": [
          "positions_daily",
          "ocp_cash",
          "pnl_tradelevel",
          "internal_market_eod",
          "trades_hourly",
          "fx_terms",
          "*"
         ]
        },
        "additionalProperties": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        }
       }
      },
      "required": [
       "book_id",
       "name",
       "desk",
       "book_type",
       "entity"
      ],
      "patternProperties": {
       "^x_": {}
      },
      "additionalProperties": false
     }
    }
   },
   "patternProperties": {
    "^_": {}
   },
   "additionalProperties": false
  }
 },
 {
  "id": "funding",
  "title": "Фондирование",
  "file": "funding.json",
  "help": "База и ставки фондирования по селекторам, с историей valid_from (ORG_RULES §2, §3, §8).",
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "title": "Правила фондирования",
   "required": [
    "rules"
   ],
   "properties": {
    "rules": {
     "type": "array",
     "title": "Правила фондирования",
     "items": {
      "type": "object",
      "properties": {
       "rule_id": {
        "type": "string",
        "minLength": 1,
        "title": "Код правила",
        "description": "Необязателен: без него строится из селекторов"
       },
       "valid_from": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "title": "Действует с",
        "description": "Смена ставки — новая строка с более поздней датой"
       },
       "active": {
        "type": "boolean",
        "title": "Действует",
        "default": true
       },
       "book_type": {
        "type": "string",
        "enum": [
         "TRADING",
         "HTM",
         "DERIVS",
         "FUTURES"
        ],
        "title": "Тип книги (селектор)"
       },
       "entity": {
        "type": "string",
        "minLength": 1,
        "title": "Юрлицо (селектор)"
       },
       "book_id": {
        "type": "string",
        "minLength": 1,
        "title": "Книга (селектор)"
       },
       "ccy": {
        "type": "string",
        "pattern": "^[A-Za-z]{3}$",
        "title": "Валюта (селектор)"
       },
       "instrument_id": {
        "type": "string",
        "minLength": 1,
        "title": "Бумага (селектор)",
        "description": "instrument_id хаба"
       },
       "basis": {
        "type": "string",
        "enum": [
         "mv_clean",
         "mv_dirty",
         "cash",
         "cost",
         "none"
        ],
        "title": "База",
        "description": "mv_clean, mv_dirty — рыночная стоимость без / с НКД; cash — кэш-баланс; cost — стоимость покупки; none — не фондируется"
       },
       "rate_kind": {
        "type": "string",
        "enum": [
         "index_spread",
         "fixed",
         "contract",
         "none"
        ],
        "title": "Ставка",
        "description": "index_spread — индекс + спред; fixed — фикс; contract — контрактная; none — не фондируется"
       },
       "index_code": {
        "type": "string",
        "minLength": 1,
        "title": "Индекс",
        "description": "Код фиксинга хаба (для index_spread)"
       },
       "spread_bp": {
        "type": [
         "number",
         "string"
        ],
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
        "title": "Спред, б.п."
       },
       "fixed_rate_pct": {
        "type": [
         "number",
         "string"
        ],
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
        "title": "Фиксированная ставка, %"
       },
       "day_count": {
        "type": "string",
        "enum": [
         "ACT/365",
         "ACT/360"
        ],
        "title": "База дней"
       }
      },
      "required": [
       "rate_kind"
      ],
      "patternProperties": {
       "^x_": {}
      },
      "additionalProperties": false
     }
    },
    "bond_class_spreads": {
     "type": "array",
     "title": "Доп. спреды по типам облигаций (в монитор пока не уходят)",
     "items": {
      "type": "object",
      "required": [
       "bond_class",
       "spread_bp"
      ],
      "additionalProperties": false,
      "properties": {
       "bond_class": {
        "type": "string",
        "minLength": 1,
        "title": "Тип облигаций"
       },
       "spread_bp": {
        "type": [
         "number",
         "string"
        ],
        "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
        "title": "Спред, б.п."
       },
       "valid_from": {
        "type": "string",
        "format": "date",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "title": "Действует с"
       }
      }
     }
    },
    "repo_policy": {
     "type": "object",
     "title": "Политика РЕПО (в монитор пока не уходит)",
     "additionalProperties": false,
     "properties": {
      "rate": {
       "type": [
        "string",
        "null"
       ],
       "enum": [
        "security",
        "contract",
        null
       ],
       "title": "Ставка РЕПО",
       "description": "security — ставка бумаги; contract — контрактная"
      },
      "contract_rate_from_days": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "title": "Контрактная ставка от срока, дней"
      },
      "valid_from": {
       "type": "string",
       "format": "date",
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
       "title": "Действует с"
      }
     }
    }
   },
   "patternProperties": {
    "^_": {}
   },
   "additionalProperties": false
  }
 },
 {
  "id": "sources",
  "title": "Источники",
  "file": "options.json",
  "help": "Какие отчёты читать, папки, оценка из отчёта, предварительные условия FX-сделок.",
  "schema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "title": "Параметры адаптера",
   "properties": {
    "auto_books": {
     "type": "boolean",
     "title": "Авто-книги из отчёта о позициях"
    },
    "report_dirs": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "title": "Папки отчётов о позициях"
    },
    "auto_books_scan_files": {
     "type": "integer",
     "minimum": 0,
     "title": "Сколько отчётов смотреть"
    },
    "sources": {
     "type": "object",
     "title": "Какие отчёты читать",
     "properties": {
      "positions_daily": {
       "type": "boolean",
       "title": "positions_daily"
      },
      "ocp_cash": {
       "type": "boolean",
       "title": "ocp_cash"
      },
      "pnl_tradelevel": {
       "type": "boolean",
       "title": "pnl_tradelevel"
      },
      "internal_market_eod": {
       "type": "boolean",
       "title": "internal_market_eod"
      },
      "trades_hourly": {
       "type": "boolean",
       "title": "trades_hourly"
      },
      "fx_terms": {
       "type": "boolean",
       "title": "fx_terms"
      }
     },
     "additionalProperties": false
    },
    "contract_1_1_fields": {
     "type": "boolean",
     "title": "Поля контракта 1.1"
    },
    "report_risk": {
     "type": "object",
     "title": "Оценка и риск из отчёта о позициях",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean",
       "title": "Включено"
      },
      "npv_ccy": {
       "type": "string",
       "enum": [
        "row",
        "RUB"
       ],
       "title": "Валюта NPV/DV01/CS01"
      },
      "dv01_sign": {
       "type": "integer",
       "enum": [
        1,
        -1
       ],
       "title": "Знак DV01"
      },
      "dv01_scale": {
       "type": "number",
       "exclusiveMinimum": 0,
       "title": "Множитель DV01"
      },
      "cs01_sign": {
       "type": "integer",
       "enum": [
        1,
        -1
       ],
       "title": "Знак CS01"
      },
      "cs01_scale": {
       "type": "number",
       "exclusiveMinimum": 0,
       "title": "Множитель CS01"
      }
     },
     "patternProperties": {
      "^_": {}
     }
    },
    "provisional_trade_terms": {
     "type": "object",
     "title": "Предварительные условия FX-сделок из отчёта о позициях",
     "additionalProperties": false,
     "patternProperties": {
      "^_": {}
     },
     "properties": {
      "enabled": {
       "type": "boolean",
       "title": "Включено"
      },
      "ndf_settle_types": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       },
       "title": "Settle Type, означающие NDF"
      },
      "rate_tolerance": {
       "type": "number",
       "minimum": 0,
       "exclusiveMaximum": 1,
       "title": "Допуск расхождения курса"
      }
     }
    }
   },
   "patternProperties": {
    "^_": {}
   },
   "additionalProperties": false
  }
 }
]